# R specific
.Rhistory
.RData
.Ruserdata
.Rproj.user/

# Quarto / RMarkdown builds
*_cache/
*.utf8.md
*.knit.md
*.html
*.pdf
_site/
!docs/**/*.html
# ...but these HTML files are served at runtime, not produced by a build:
# the privacy notice (9.1) and Nginx's capacity page (8.2). Without this they
# are silently dropped and a fresh checkout 404s them.
!app/www/**/*.html
!infra/nginx/**/*.html

# Project data (large, not for Git)
.vscode/
.quarto/

# OS files
.DS_Store
Thumbs.db

# Nix
result
*.lock

# Secrets: never commit the real .env (see .env.example)
.env
.env.*
!.env.example

/.quarto/

# Cypress artifacts (specs are committed; what they produce is not)
app/cypress/screenshots/
app/cypress/videos/
app/cypress/downloads/
app/cypress/results/
node_modules/

# Load-test output (dev/load_test.sh): per-run logs, JSONL and the report
app/dev/load/
# ...and the same output when the run was pointed at the repo root instead
# (LOAD_OUT_DIR=tmp-load-out*): 26 debugging runs of 2026-10-09, superseded
# by the ones under app/dev/load/.
tmp-load-out*/
