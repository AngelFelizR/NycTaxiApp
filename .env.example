# Copy to .env at the repo root. The real .env is gitignored.
# Secrets: generate with `openssl rand -base64 32` and never commit them.

# --- PostgreSQL (private network only, never exposed to the host) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nyctaxi
POSTGRES_USER=nyctaxi
POSTGRES_PASSWORD=

# --- Redis (private network only) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Service wiring ---
# Base URL of the private API, used by app/ and share/ (Docker network hostname).
TAXI_API_URL=http://api:8000
# Service-to-service key: every API endpoint requires X-Internal-Key (403 without it).
API_INTERNAL_KEY=
# Public origin of the share pages (7.3): Results builds {base}/share/{token}.
# Same host as TAXI_API_URL outside Docker; empty means the production domain.
SHARE_BASE_URL=
# Salt for SHA-256(IP_HASH_SALT || ip). Rotating it resets rate-limit counters.
IP_HASH_SALT=

# --- Model/data files (downloaded once from the v0.0.1-data release) ---
# Host directory mounted read-only at /models in the dev container.
MODELS_DIR=
# Host directory mounted read-only at /data in the dev container
# (NycTrips2024_sample_week.parquet, ZonesShapes.qs2).
DATA_DIR=

# --- Versions and environment ---
APP_VERSION=0.1.0
# Data release tag: https://github.com/AngelFelizR/NycTaxiApp/releases/tag/v0.0.1-data
MODEL_VERSION=0.0.1-data
# production | development (controls CORS and error verbosity)
ENV=development

# --- Email (share-email endpoint, phase 6) ---
SMTP_URL=

# --- Cloudflare (DNS API token for cache rules, phase 7) ---
CF_API_TOKEN=
