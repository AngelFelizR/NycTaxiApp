# Copy to .env at the repo root. The real .env is gitignored.
# Secrets: generate with `openssl rand -base64 32` and never commit them.
#
# Nothing here overrides what Docker injects: `load_dotenv()` in the services
# and `env_file:` in the compose files never replace a variable that is already
# set, so a value in .env is a default, not a command.

# --- PostgreSQL (private network only, never exposed to the host) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nyctaxi
POSTGRES_USER=nyctaxi
POSTGRES_PASSWORD=

# --- Redis (private network only) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Service wiring ---
# Base URL of the private API, used by app/ and share/ (Docker network hostname).
# Outside Docker (a manual `Rscript share/plumber.R`) set it to
# http://127.0.0.1:8000 or the service answers 503 on purpose.
TAXI_API_URL=http://api:8000
# Service-to-service key: every API endpoint requires X-Internal-Key (403 without it).
API_INTERNAL_KEY=
# Public origin of the share pages (7.3): Results builds {base}/share/{token}.
# Same host as TAXI_API_URL outside Docker; empty means the production domain.
SHARE_BASE_URL=
# Salt for SHA-256(IP_HASH_SALT || ip). Rotating it resets rate-limit counters.
IP_HASH_SALT=

# Where the API reaches share/ from, to put the card link in the email (5.6).
# docker-compose.prod.yml sets this to http://share:8001; only change it when
# running the API outside compose.
SHARE_URL=
# share/ listeners. Set by docker-compose.prod.yml (0.0.0.0:8001); a manual
# run defaults to 0.0.0.0:8020.
SHARE_HOST=
SHARE_PORT=
# Directory holding shared/curves.yaml and shared/brand.yaml. Resolved by
# candidate (../shared, ../../shared, ...) so it is normally left empty;
# set it only for a layout that does not mirror the repository (docs/decisions/0003).
SHARED_DIR=

# --- Model/data files (downloaded once from the v0.0.1-data release) ---
# Host directory mounted read-only at /models in the dev container.
MODELS_DIR=
# Host directory mounted read-only at /data in the dev container
# (NycTrips2024_sample_week.parquet, ZonesShapes.qs2).
DATA_DIR=
# Paths inside a container, overriding the /models and /data defaults. Only
# needed when the mount point differs from the documented one.
TAXI_MODELS_DIR=
TAXI_DATA_DIR=

# --- Versions and environment ---
APP_VERSION=0.1.0
# Data release tag: https://github.com/AngelFelizR/NycTaxiApp/releases/tag/v0.0.1-data
MODEL_VERSION=0.0.1-data
# production | development (controls CORS and error verbosity).
# docker-compose.prod.yml pins this to production: .env is shared with the
# development stack.
ENV=development

# API bind address. docker-compose.prod.yml sets 0.0.0.0:8000; a manual run
# of `Rscript api/plumber.R` defaults to the same.
API_HOST=
API_PORT=

# --- Email (share-email endpoint, section 5.6) ---
# smtp://user:pass@host:587 (or smtps:// for implicit TLS). Delivery goes
# through the `curl` CLI; without it POST /share-email answers 503 and the UI
# shows a retryable error rather than pretending it worked.
SMTP_URL=
# Envelope sender. Must be an address whose domain publishes the SPF/DKIM
# records documented in docs/operations/first-deploy.md, or the mail is
# accepted and then discarded as spam.
SMTP_FROM=no-reply@angelfeliz.com
# STARTTLS on a plain smtp:// URL (587). Set to 0 only for a local test relay.
SMTP_STARTTLS=1

# --- Diagnostics and development overrides (leave empty in production) ---
# Any non-empty value logs the prediction inputs/outputs of /predict.
API_TRACE=
# 1 makes POST /experiments compute the three trajectories inside the request
# instead of forking. The test suite sets it; never set it in production, it
# removes the async behaviour section 4.6 is built on.
API_EXPERIMENTS_SYNC=

# --- Cloudflare (section 8.4) ---
# Only needed if the /share/*.png cache rule and the DNS records are managed
# through the API instead of the dashboard; safe to leave empty.
CF_API_TOKEN=
