Package: taxiapp
Title: Decide as Taxi Driver For A Day
Version: 0.1.0
Description: Thin Shiny client for a plumber2 API. The app only renders UI and
    calls the API (httr2, executed in mirai daemons); all decisions live in the API.
Depends:
    R (>= 4.1.0)
Imports:
    shiny (>= 1.9.0),
    bslib (>= 0.7.0),
    leaflet,
    sf,
    ggplot2,
    httr2 (>= 1.0.0),
    mirai,
    promises,
    shinyjs,
    qs2,
    jsonlite,
    yaml
Suggests:
    testthat (>= 3.0.0),
    shinytest2,
    plumber2
Config/testthat/edition: 3
